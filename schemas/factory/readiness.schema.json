{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fusupo/escapement/schemas/factory/readiness.schema.json",
  "title": "Escapement factory readiness check",
  "description": "Whether a work item is ready to run (docs/FACTORY_DESIGN.md §3.1). `factory check` reports mechanical gaps; a planning agent adds judgment questions (intent, scope, dependencies) in the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "questions"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["ready", "needs_human"] },
    "questions": {
      "description": "Specific questions a human must answer. Empty exactly when status is ready.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["about", "question"],
        "properties": {
          "about": { "enum": ["contract", "criterion", "evidence", "settings", "intent", "scope", "dependency"] },
          "question": { "type": "string", "minLength": 1 },
          "ref": { "description": "What the question is about: a criterion or evidence ID, a settings key, or a JSON pointer into the contract.", "type": "string" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "reasons"],
      "properties": {
        "tier": { "enum": ["standard", "sensitive"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "required_checks": {
      "description": "The checks every attempt runs in full, from project settings.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": { "enum": ["setup", "static", "verify"] },
          "command": { "type": ["string", "null"] }
        }
      }
    },
    "settings_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "if": { "properties": { "status": { "const": "ready" } } },
  "then": { "properties": { "questions": { "type": "array", "maxItems": 0 } } },
  "else": { "properties": { "questions": { "type": "array", "minItems": 1 } } }
}
